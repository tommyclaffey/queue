# The public Queue demo (its own link on Railway). A made-up business, "Harbor Collective", with a
# made-up team. Nothing in it can post anywhere: the demo has no Instagram client at all, and
# uploads, re-encodes and quality measuring are switched off (DEMO_PUBLIC=1).
#
# The sample videos, photos and their pre-measured quality scores (~550 MB) are not in git. They
# ship as one file on a GitHub release, made with:
#   tar -cf queue-demo.tar --exclude settings.json --exclude list.tsv --exclude avatar.jpg demo/assets demo/media demo/data
#   split -b 95m queue-demo.tar queue-demo.part-      (GitHub drops single uploads this big)
#   gh release upload demo-v1 queue-demo.part-* --clobber
# and DEMO_SHA256 = shasum -a 256 queue-demo.tar, so a broken download fails the build.
FROM node:22-trixie-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ARG DEMO_RELEASE=https://github.com/tommyclaffey/queue/releases/download/demo-v1
ARG DEMO_PARTS="aa ab ac ad ae af"
ARG DEMO_SHA256=1ca59151432fdb0532f05b07b3bd586e9faaffa1a6b7a8b57e628d79ea117544
RUN set -e; cd /tmp; for p in $DEMO_PARTS; do curl -fsSL --retry 3 -o "part-$p" "$DEMO_RELEASE/queue-demo.part-$p"; done; \
    cat part-* > demo.tar; echo "$DEMO_SHA256  demo.tar" | sha256sum -c -; \
    tar -xf demo.tar -C /app; rm -f part-* demo.tar
COPY package.json ./
COPY bin ./bin
COPY src ./src
COPY public ./public
ENV NODE_ENV=production DEMO_PUBLIC=1 DEMO_RESET_HOURS=3
CMD ["node", "bin/queue.js", "demo"]

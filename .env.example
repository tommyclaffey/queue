# Copy to .env and fill in. Leave IG_ACCESS_TOKEN blank to run in DRY RUN mode.
# Setup steps: see the vault note "(C) Queue — Meta Setup Guide".

# Which Meta setup you used:
#   instagram = "API setup with Instagram Login" (simplest, no Facebook Page). Recommended.
#   facebook  = Instagram linked to a Facebook Page. Allows direct upload instead of a temporary link.
IG_LOGIN=instagram

# Paste the token from the Meta dashboard ("Generate token"). Queue renews it automatically.
IG_ACCESS_TOKEN=

# Instagram login: leave blank (Queue uses "me").
# Facebook login: your Instagram Business Account ID (a long number).
IG_USER_ID=

GRAPH_VERSION=v25.0

# How early to hand the video to Instagram before the post time, in minutes (max 1380 = 23h).
STAGE_WINDOW_MIN=120

# If the Mac was off at post time: posts more than this many minutes late wait for your OK
# ("Post now" in the web app) instead of going out by surprise.
LATE_LIMIT_MIN=120

# Mac notifications when a post goes live, fails, or is missed. 0 = off.
NOTIFY=1

# Advanced — leave blank unless you know you need them.
# PUBLIC_BASE_URL=    # your own public host for video links instead of a Cloudflare tunnel
# SHARE_PORT=         # local port for that host to forward to
# UPLOAD_MODE=        # force "resumable" or "url"
# PORT=4400
